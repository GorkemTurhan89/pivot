@{
    ViewData["Title"] = "Giriş";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="row justify-content-center">
    <div class="col-md-4">
        <h1 class="mb-3">Giriş</h1>
        <form method="post" asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@returnUrl" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="mb-3">
                <label for="username" class="form-label">Kullanıcı adı</label>
                <input type="text" id="username" name="username" class="form-control" required autofocus autocomplete="username" />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Şifre</label>
                <input type="password" id="password" name="password" class="form-control" required autocomplete="current-password" />
            </div>
            <button type="submit" class="btn btn-primary w-100">Giriş</button>
        </form>
        <p class="text-muted small mt-3">
            Geliştirme stub'ı: <code>admin</code> / <code>admin</code>. Gerçek kullanıcı tablosu sonraki adımda gelecek.
        </p>
    </div>
</div>
