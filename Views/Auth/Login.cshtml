@{
    ViewData["Title"] = "Giriş";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="row justify-content-center">
    <div class="col-md-4">
        <h1 class="mb-3">Giriş</h1>
        <form method="post" asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@returnUrl" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="mb-3">
                <label for="usernameOrEmail" class="form-label">Kullanıcı adı veya e-posta</label>
                <input type="text" id="usernameOrEmail" name="usernameOrEmail" class="form-control" required autofocus autocomplete="username" />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Şifre</label>
                <div class="input-group">
                    <input type="password" id="password" name="password" class="form-control" required autocomplete="current-password" />
                    <span class="input-group-text password-peek" data-target="password"
                          style="cursor:pointer;user-select:none;" title="Üstüne gelince göster">👁</span>
                </div>
            </div>
            <button type="submit" class="btn btn-primary w-100">Giriş</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.password-peek').forEach(eye => {
            const input = document.getElementById(eye.dataset.target);
            if (!input) return;
            eye.addEventListener('mouseenter', () => input.type = 'text');
            eye.addEventListener('mouseleave', () => input.type = 'password');
        });
    </script>
}
