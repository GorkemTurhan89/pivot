@{
    ViewData["Title"] = "Veri Yönetimi";
}

<h1 class="mb-4">Veri Export / Import</h1>

@if (TempData["Saved"] is string saved)
{
    <div class="alert alert-success">@saved</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="row g-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Export</h5>
                <p class="card-text small text-muted">
                    Catalog tablolarının (Countries / Cities / Schools / Programs / PaymentPlans /
                    MainAddOnLinks / Accommodation / Supplement / ExtraServices) güncel halini
                    tek ZIP içinde CSV olarak indir. Üye/sepet/auth tabloları dahil değil.
                </p>
                <a asp-action="Export" class="btn btn-primary">ZIP indir</a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Import</h5>
                <p class="card-text small text-danger">
                    Bu işlem catalog tablolarındaki <strong>tüm mevcut veriyi siler</strong> ve ZIP'ten
                    yeniden yükler. Üye/sepet kayıtları etkilenmez ama paket Id'leri değişirse eski
                    referanslar bozulabilir. Devam etmeden önce mevcut veriyi <strong>Export</strong>
                    butonuyla yedeklemen önerilir.
                </p>
                <form method="post" asp-action="Import" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="file" class="form-label">ZIP dosyası</label>
                        <input type="file" id="file" name="file" class="form-control" accept=".zip" required />
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="confirm" name="confirm" value="true" required />
                        <label class="form-check-label" for="confirm">
                            Mevcut catalog verisinin tamamen değiştirileceğini onaylıyorum.
                        </label>
                    </div>
                    <button type="submit" class="btn btn-danger">İçe aktar</button>
                </form>
            </div>
        </div>
    </div>
</div>
