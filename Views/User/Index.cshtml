@model IEnumerable<Pivot.Models.Entities.User>
@using Pivot.Models.Auth
@{
    ViewData["Title"] = "Kullanıcılar";
    var isSuperAdmin = (bool)(ViewData["IsSuperAdmin"] ?? false);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Kullanıcılar</h1>
    <a asp-action="Create" class="btn btn-primary">Yeni kullanıcı</a>
</div>

@if (!isSuperAdmin)
{
    <p class="text-muted small">Sadece satış temsilcisi (SalesRep) kullanıcıları üzerinde işlem yapabilirsin.</p>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Id</th>
            <th>Kullanıcı adı</th>
            <th>E-posta</th>
            <th>Rol</th>
            <th>Kayıt</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var u in Model)
    {
        var badgeClass = u.Role switch
        {
            Roles.SuperAdmin => "bg-danger",
            Roles.Admin => "bg-warning text-dark",
            _ => "bg-secondary"
        };
        var canManage = isSuperAdmin
            ? u.Role != Roles.SuperAdmin
            : u.Role == Roles.SalesRep;
        <tr>
            <td>@u.Id</td>
            <td>@u.Username</td>
            <td>@u.Email</td>
            <td><span class="badge @badgeClass">@u.Role</span></td>
            <td>@u.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
            <td class="d-flex gap-2">
                @if (canManage)
                {
                    if (isSuperAdmin)
                    {
                        <a asp-action="EditRole" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Rol</a>
                    }
                    <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary">Şifre</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
