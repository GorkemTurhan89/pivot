@model IEnumerable<Pivot.Models.Entities.User>
@{
    ViewData["Title"] = "Kullanıcılar";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Kullanıcılar</h1>
    <a asp-action="Create" class="btn btn-primary">Yeni kullanıcı</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Id</th>
            <th>Kullanıcı adı</th>
            <th>E-posta</th>
            <th>Tip</th>
            <th>Kayıt</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.Id</td>
            <td>@u.Username</td>
            <td>@u.Email</td>
            <td>
                @if (u.IsSuperAdmin)
                {
                    <span class="badge bg-danger">Super Admin</span>
                }
                else
                {
                    <span class="badge bg-secondary">Kullanıcı</span>
                }
            </td>
            <td>@u.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
            <td>
                <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary">Şifre Sıfırla</a>
            </td>
        </tr>
    }
    </tbody>
</table>
