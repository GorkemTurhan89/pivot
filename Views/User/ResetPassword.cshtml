@{
    ViewData["Title"] = "Şifre Sıfırla";
    var userId = (int)ViewData["UserId"]!;
    var username = ViewData["Username"] as string;
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1 class="mb-3">Şifre sıfırla</h1>
        <p class="text-muted"><strong>@username</strong> kullanıcısının şifresini değiştir.</p>

        <form method="post" asp-action="ResetPassword" asp-route-id="@userId" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

            <div class="mb-3">
                <label for="password" class="form-label">Yeni şifre</label>
                <div class="input-group">
                    <input type="password" id="password" name="password" class="form-control" required minlength="8" autocomplete="new-password" autofocus />
                    <span class="input-group-text password-peek" data-target="password"
                          style="cursor:pointer;user-select:none;" title="Üstüne gelince göster">👁</span>
                </div>
                <small class="text-muted">Min 8 karakter.</small>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Güncelle</button>
                <a asp-action="Index" class="btn btn-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.password-peek').forEach(eye => {
            const input = document.getElementById(eye.dataset.target);
            if (!input) return;
            eye.addEventListener('mouseenter', () => input.type = 'text');
            eye.addEventListener('mouseleave', () => input.type = 'password');
        });
    </script>
}
