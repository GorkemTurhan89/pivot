@{
    ViewData["Title"] = "Ek Hizmetler";
}

<h1 class="mb-3">Ek Hizmetler</h1>

<div id="selectionInfo" class="mb-3"></div>

<div id="addOnsContainer">
    <p class="text-muted">Yükleniyor...</p>
</div>

<div class="mt-4">
    <a href="/Search" class="btn btn-outline-secondary">← Paket seçimine dön</a>
    <button id="continueBtn" class="btn btn-primary" disabled>Devam (Ek Hizmetler)</button>
</div>

<div class="modal fade" id="conditionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Koşullu Ek Hizmet</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p><strong id="condTitle"></strong></p>
                <p id="condNotes" class="text-muted"></p>
                <p class="small mb-0"><em>Bu koşulun sizin durumunuza uygun olduğunu onaylarsanız ek hizmeti seçebilirsiniz.</em></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="button" id="condConfirmBtn" class="btn btn-danger">Koşul benim için geçerli</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const info = document.getElementById('selectionInfo');
            const container = document.getElementById('addOnsContainer');

            const raw = localStorage.getItem('pivot.selection');
            if (!raw) {
                info.innerHTML = '<div class="alert alert-warning mb-0">Önce bir ana paket seçmelisiniz.</div>';
                container.innerHTML = '';
                return;
            }

            const sel = JSON.parse(raw);

            info.innerHTML = `
                <div class="alert alert-info mb-0">
                    <strong>Seçilen paket:</strong> ${sel.planName ?? '-'}
                    <span class="text-muted">— ${sel.schoolName ?? ''}, ${sel.cityName ?? ''} / ${sel.countryName ?? ''}</span>
                </div>`;

            const defaultWeeks = parseInt(sel.requestedLengthOfMain, 10) || 1;

            const continueBtn = document.getElementById('continueBtn');
            continueBtn.disabled = false;
            continueBtn.addEventListener('click', () => {
                const checks = [...document.querySelectorAll('.addon-check:checked, .supp-check:checked')];
                const ids = checks.map(c => parseInt(c.value, 10));
                // Weekly addon'lar için per-addon hafta map'i: {addonId: weeks}
                const weeksMap = {};
                checks.forEach(c => {
                    const row = c.closest('tr');
                    const wInput = row.querySelector('.addon-weeks');
                    if (wInput) {
                        const w = parseInt(wInput.value, 10);
                        if (!isNaN(w) && w > 0) weeksMap[c.value] = w;
                    }
                });
                localStorage.setItem('pivot.selectedAddOns', JSON.stringify(ids));
                localStorage.setItem('pivot.addOnWeeks', JSON.stringify(weeksMap));
                window.location.href = '/Search/ExtraServices';
            });

            const fmt = v => Number(v).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            async function load() {
                const res = await fetch(`/Search/GetAddOns?schoolId=${sel.schoolId}&mainPlanId=${sel.mainPlanId}`);
                if (!res.ok) {
                    container.innerHTML = '<div class="alert alert-danger">Ek hizmetler yüklenemedi.</div>';
                    return;
                }
                render(await res.json());
            }

            function render(addOns) {
                if (!addOns || addOns.length === 0) {
                    container.innerHTML = '<p class="text-muted">Bu paket için ek hizmet bulunmuyor.</p>';
                    return;
                }
                const rows = addOns.map(a => {
                    const isKonaklama = (a.category || '').toLowerCase() === 'konaklama';
                    return `
                    <tr data-addon-id="${a.id}" ${isKonaklama ? 'data-accommodation="1"' : ''}>
                        <td>
                            <input type="checkbox" class="form-check-input addon-check"
                                   value="${a.id}" ${a.isMandatory ? 'checked disabled' : ''} />
                        </td>
                        <td>
                            ${a.name}
                            ${a.isMandatory ? '<span class="badge bg-danger ms-1">Zorunlu</span>' : ''}
                        </td>
                        <td>${a.category ?? ''}</td>
                        <td class="text-end">
                            ${fmt(a.price)} ${a.currency}${a.priceType === 'Weekly' ? '/hafta' : ''}
                            ${a.priceType === 'Weekly'
                                ? `<input type="number" class="form-control form-control-sm d-inline-block ms-2 addon-weeks"
                                          data-addon-id="${a.id}" value="${defaultWeeks}" min="1"
                                          title="Bu hizmet için hafta" style="width:5rem">`
                                : ''}
                        </td>
                    </tr>`;
                }).join('');

                container.innerHTML = `
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th style="width:3rem;"></th>
                                <th>Hizmet</th>
                                <th>Kategori</th>
                                <th class="text-end">Fiyat</th>
                            </tr>
                        </thead>
                        <tbody>${rows}</tbody>
                    </table>
                    <small class="text-muted">Zorunlu hizmetler otomatik seçilidir ve kaldırılamaz. Konaklama seçtiğinizde uygulanabilir ek hizmetler (supplement) altında görünür.</small>`;

                wireAccommodationSupplements();
                wireConditionLocks();
            }

            // Bir accommodation check edilince supplement'larını dinamik getir, uncheck edilince kaldır.
            function wireAccommodationSupplements() {
                container.querySelectorAll('tr[data-accommodation="1"] .addon-check').forEach(cb => {
                    cb.addEventListener('change', async (e) => {
                        const row = e.target.closest('tr');
                        const accId = parseInt(row.dataset.addonId, 10);
                        if (e.target.checked) {
                            await loadSupplementsAfter(row, accId);
                        } else {
                            removeSupplementsAfter(row, accId);
                        }
                    });
                });
            }

            async function loadSupplementsAfter(accRow, accId) {
                const res = await fetch(`/Search/GetSupplements?accommodationId=${accId}`);
                if (!res.ok) return;
                const supps = await res.json();
                if (!supps.length) return;
                let after = accRow;
                supps.forEach(s => {
                    const dateRange = (s.startDate || s.endDate)
                        ? `<small class="text-muted ms-1">(${s.startDate ?? ''}${s.endDate ? ' → ' + s.endDate : ''})</small>`
                        : '';
                    const conditional = s.isConditional;
                    const rowClass = conditional ? 'supp-row table-danger' : 'supp-row table-warning';
                    const lockIcon = conditional
                        ? `<button type="button" class="btn btn-sm btn-link p-0 ms-2 cond-lock"
                                   data-supp-id="${s.id}" data-name="${escapeAttr(s.name)}"
                                   data-notes="${escapeAttr(s.conditionNotes ?? '')}" title="Koşulu gör">🔒</button>`
                        : '';
                    const html = `
                        <tr class="${rowClass}" data-supp-of="${accId}" data-supp-id="${s.id}">
                            <td class="ps-4">
                                <input type="checkbox" class="form-check-input supp-check"
                                       value="${s.id}" ${conditional ? 'disabled' : ''} />
                            </td>
                            <td>↳ ${s.name} ${dateRange} ${lockIcon}</td>
                            <td>Supplement / ${s.appliesTo}</td>
                            <td class="text-end">
                                ${fmt(s.weeklyFee)} ${s.currency}/hafta
                                <input type="number" class="form-control form-control-sm d-inline-block ms-2 addon-weeks"
                                       data-addon-id="${s.id}" value="${defaultWeeks}" min="1"
                                       title="Bu supplement için hafta" style="width:5rem">
                            </td>
                        </tr>`;
                    after.insertAdjacentHTML('afterend', html);
                    after = after.nextElementSibling;
                });
                wireConditionLocks();
            }

            function removeSupplementsAfter(accRow, accId) {
                container.querySelectorAll(`tr.supp-row[data-supp-of="${accId}"]`).forEach(r => r.remove());
            }

            function wireConditionLocks() {
                container.querySelectorAll('.cond-lock').forEach(btn => {
                    if (btn.dataset.wired) return;
                    btn.dataset.wired = '1';
                    btn.addEventListener('click', () => openConditionModal(btn));
                });
            }

            let activeLock = null;
            const condModalEl = document.getElementById('conditionModal');
            const condModal = new bootstrap.Modal(condModalEl);
            document.getElementById('condConfirmBtn').addEventListener('click', () => {
                if (!activeLock) return;
                const suppId = activeLock.dataset.suppId;
                const row = container.querySelector(`tr.supp-row[data-supp-id="${suppId}"]`);
                if (row) {
                    const cb = row.querySelector('.supp-check');
                    cb.disabled = false;
                    cb.checked = true;
                    row.classList.remove('table-danger');
                    row.classList.add('table-warning');
                    activeLock.remove();
                }
                activeLock = null;
                condModal.hide();
            });

            function openConditionModal(btn) {
                activeLock = btn;
                document.getElementById('condTitle').textContent = btn.dataset.name;
                document.getElementById('condNotes').textContent = btn.dataset.notes || '(koşul açıklaması yok)';
                condModal.show();
            }

            function escapeAttr(s) {
                return String(s).replace(/"/g, '&quot;').replace(/</g, '&lt;');
            }

            load();
        })();
    </script>
}
