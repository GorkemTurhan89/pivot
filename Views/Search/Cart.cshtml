@{
    ViewData["Title"] = "Sepet";
}

<h1 class="mb-3">Sepet</h1>

<div id="memberCard" class="mb-3"></div>

<div id="cartContainer">
    <p class="text-muted">Yükleniyor...</p>
</div>

<div class="mt-4">
    <a href="/Search/ExtraServices" class="btn btn-outline-secondary">← Ek hizmetlere (vize/uçak) dön</a>
</div>

@section Scripts {
    <script>
        (function () {
            const container = document.getElementById('cartContainer');

            const rawSel = localStorage.getItem('pivot.selection');
            if (!rawSel) {
                container.innerHTML = '<div class="alert alert-warning mb-0">Önce bir ana paket seçmelisiniz.</div>';
                return;
            }
            const sel = JSON.parse(rawSel);
            const addOnIds = JSON.parse(localStorage.getItem('pivot.selectedAddOns') ?? '[]');

            const money = (v, c) => `${v.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ${c}`;

            async function load() {
                const params = new URLSearchParams();
                params.set('mainPlanId', sel.mainPlanId);
                params.set('weeks', sel.requestedLengthOfMain ?? 1);
                params.set('startDate', sel.startDate ?? new Date().toISOString().slice(0, 10));
                addOnIds.forEach(id => params.append('addOnIds', id));
                params.set('addOnWeeksJson', localStorage.getItem('pivot.addOnWeeks') ?? '{}');
                params.set('extrasJson', localStorage.getItem('pivot.extras') ?? '[]');
                // CRM: cartGuid varsa snapshot persist için backend'e geçir (ileri/geri arası
                // aynı sepet kaydını güncelleriz).
                const lead = JSON.parse(localStorage.getItem('pivot.lead') ?? 'null');
                if (lead && lead.cartGuid) params.set('cartGuid', lead.cartGuid);

                const res = await fetch(`/Search/GetCart?${params.toString()}`);
                if (!res.ok) {
                    container.innerHTML = '<div class="alert alert-danger">Sepet yüklenemedi.</div>';
                    return;
                }
                render(await res.json());
            }

            const esc = s => String(s ?? '').replace(/</g, '&lt;');

            function renderMember(c) {
                const memberCard = document.getElementById('memberCard');
                if (!c.member) { memberCard.innerHTML = ''; return; }
                const m = c.member;
                memberCard.innerHTML = `
                    <div class="card">
                        <div class="card-body py-3">
                            <h6 class="card-title mb-3">Müşteri Bilgileri</h6>
                            <div class="row g-2 small">
                                <div class="col-md-6"><strong>Ad Soyad:</strong> ${esc(m.firstName)} ${esc(m.lastName)}</div>
                                <div class="col-md-6"><strong>E-posta:</strong> ${esc(m.email ?? '—')}</div>
                                <div class="col-md-6"><strong>Doğum Tarihi:</strong> ${esc(m.birthday)}</div>
                                <div class="col-md-6"><strong>Kayıt Tarihi:</strong> ${esc(c.startDate)}</div>
                            </div>
                        </div>
                    </div>`;
            }

            function render(c) {
                renderMember(c);
                const cur = c.currency;
                const rows = [];

                rows.push(`
                    <tr>
                        <td>${c.main.name}</td>
                        <td class="text-muted">${c.main.weeks} hafta × ${money(c.main.weeklyRate, cur)}</td>
                        <td class="text-end">${money(c.main.lineTotal, cur)}</td>
                    </tr>`);

                if (c.registrationFee != null) {
                    rows.push(`
                        <tr>
                            <td>Kayıt Ücreti</td>
                            <td></td>
                            <td class="text-end">${money(c.registrationFee, cur)}</td>
                        </tr>`);
                }

                c.addOns.forEach(a => {
                    rows.push(`
                        <tr>
                            <td>${a.name} ${a.isMandatory ? '<span class="badge bg-danger ms-1">Zorunlu</span>' : ''}</td>
                            <td class="text-muted">${a.category ?? ''}${a.weeks > 0 ? ' · ' + a.weeks + ' hafta' : ''}</td>
                            <td class="text-end">${money(a.amount, cur)}</td>
                        </tr>`);
                    if (a.registrationFee != null && a.registrationFee > 0) {
                        rows.push(`
                        <tr>
                            <td class="ps-4 text-muted">↳ Kayıt/Yerleştirme</td>
                            <td></td>
                            <td class="text-end">${money(a.registrationFee, cur)}</td>
                        </tr>`);
                    }
                });

                // Extras (Vize / Uçak / Manuel) — currency kalem bazlı (her satır kendi para birimi)
                (c.extras ?? []).forEach(e => {
                    rows.push(`
                        <tr>
                            <td>${e.name}</td>
                            <td class="text-muted">${e.category ?? ''}</td>
                            <td class="text-end">${money(e.amount, cur)}</td>
                        </tr>`);
                });

                container.innerHTML = `
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Kalem</th>
                                <th>Detay</th>
                                <th class="text-end">Tutar</th>
                            </tr>
                        </thead>
                        <tbody>${rows.join('')}</tbody>
                        <tfoot>
                            <tr class="table-active fw-bold">
                                <td colspan="2">Toplam</td>
                                <td class="text-end">${money(c.total, cur)}</td>
                            </tr>
                        </tfoot>
                    </table>`;
            }

            load();
        })();
    </script>
}
