@model Pivot.Models.ViewModels.QuoteViewModel
@{
    Layout = null;
    ViewData["Title"] = "Fiyat Teklifi";
    var cul = System.Globalization.CultureInfo.GetCultureInfo("tr-TR");
    string Money(decimal v) => v.ToString("N2", cul);
    string Date(DateTime dt) => dt.ToString("dd.MM.yyyy", cul);
    string DateOnlyTr(DateOnly? d) => d.HasValue ? d.Value.ToString("dd.MM.yyyy", cul) : "—";
}
<!doctype html>
<html lang="tr">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Pivot Edu — Fiyat Teklifi</title>
<style>
    @@page { size: A4; margin: 0; }
    :root {
        --navy:#082554; --navy2:#163D7C; --orange:#F05A24;
        --soft:#F6F8FC; --soft2:#EEF3FA; --line:#E4E9F2; --text:#102B5C; --muted:#7E8796;
    }
    *{box-sizing:border-box}
    body{margin:0;background:#e9edf5;font-family:Arial, Helvetica, sans-serif;color:var(--text);}
    .page{width:794px;min-height:1123px;margin:0 auto;background:white;position:relative;overflow:hidden;padding-bottom:28px;}
    .header{height:90px;background:linear-gradient(135deg,var(--navy),var(--navy2));color:#fff;position:relative;padding:14px 48px;display:flex;align-items:center;justify-content:space-between;border-bottom:5px solid var(--orange);}
    .header:before{content:"";position:absolute;width:240px;height:240px;border-radius:50%;background:rgba(255,255,255,.065);right:-60px;top:-80px;}
    .header:after{content:"";position:absolute;width:280px;height:280px;border-radius:50%;background:rgba(255,255,255,.035);left:240px;top:-90px;}
    .brand{z-index:1;font-size:24px;font-weight:900;letter-spacing:1.2px;}
    .quote{z-index:1;text-align:right;}
    .quote-big{font-size:22px;font-weight:900;letter-spacing:1.2px;color:#fff;text-transform:uppercase;}
    .quote-date{margin-top:6px;font-size:11px;font-weight:700;color:#DDE7F8;}
    .content{padding:14px 48px 0;}

    .parties{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;}
    .party{background:#fff;border:1px solid var(--line);border-radius:10px;padding:10px 16px;box-shadow:0 8px 16px rgba(7,36,87,.04);}
    .party h4{margin:0 0 6px;font-size:11px;color:var(--orange);letter-spacing:1.4px;text-transform:uppercase;}
    .party .nm{font-size:15px;font-weight:900;color:var(--navy);margin-bottom:4px;}
    .party .row{font-size:11.5px;color:var(--text);margin-top:2px;}
    .party .row strong{display:inline-block;min-width:78px;color:var(--muted);font-weight:700;}

    .info-card{background:linear-gradient(135deg,#F8FAFE,#EEF3FA);border-radius:12px;padding:13px 24px;border-left:5px solid var(--orange);box-shadow:0 14px 28px rgba(7,36,87,.07);}
    .school{font-size:20px;font-weight:900;margin-bottom:10px;color:var(--navy);}
    .info-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px 30px;}
    .info-item{display:flex;gap:12px;align-items:center;min-height:32px;}
    .ico{width:30px;height:30px;border-radius:9px;background:var(--orange);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;flex:0 0 30px;font-size:14px;}
    .label{font-size:10px;font-weight:900;color:#8B8F99;letter-spacing:1.4px;text-transform:uppercase;margin-bottom:2px;}
    .value{font-size:14px;font-weight:900;color:var(--navy);}

    .section-title{font-size:15px;font-weight:900;color:var(--navy);margin:12px 0 8px;display:inline-block;padding-bottom:5px;border-bottom:3px solid var(--orange);}
    table{width:100%;border-collapse:separate;border-spacing:0;overflow:hidden;border-radius:10px;box-shadow:0 13px 25px rgba(7,36,87,.06);font-size:13px;}
    th{background:var(--navy);color:#fff;text-align:left;padding:8px 18px;font-size:11px;letter-spacing:1.6px;text-transform:uppercase;}
    th:last-child{text-align:right;}
    td{padding:7px 18px;border-bottom:1px solid var(--line);font-weight:800;color:var(--navy);background:#fff;}
    td:last-child{text-align:right;white-space:nowrap;}
    td.detail{font-weight:500;color:var(--muted);font-size:11.5px;}
    tr:last-child td{border-bottom:none;}
    .total-row td{background:#FFF1EA;color:var(--orange);font-weight:900;}

    .summary{margin-top:12px;background:linear-gradient(135deg,var(--navy),#294D86);border-radius:13px;padding:14px 26px;color:#fff;display:flex;align-items:center;justify-content:space-between;box-shadow:0 16px 32px rgba(7,36,87,.2);position:relative;overflow:hidden;}
    .summary:after{content:"";position:absolute;width:160px;height:160px;border-radius:50%;background:rgba(240,90,36,.2);right:-35px;top:-36px;}
    .sum-sub{font-size:11px;color:#C8D6EF;letter-spacing:1.4px;text-transform:uppercase;}
    .sum-title{font-size:18px;font-weight:900;margin-top:2px;}
    .sum-note{font-size:11px;color:#C8D6EF;margin-top:3px;}
    .sum-amount{font-size:28px;font-weight:900;z-index:1;}
    .sum-amount span{font-size:14px;margin-right:5px;color:#FFA779;}

    .note{margin-top:10px;background:#FFF4EE;border-left:5px solid var(--orange);border-radius:10px;padding:9px 18px;color:#4B3A33;font-size:11.5px;line-height:1.35;}
    .footer{margin:9px 48px 0;border-top:1px solid var(--line);padding-top:7px;text-align:center;color:#9299A6;font-size:10.5px;letter-spacing:.4px;line-height:1.3;}
    .footer b{color:var(--orange);}

    @@media print {
        body{background:#fff;}
        .page{box-shadow:none;}
        .no-print{display:none !important;}
    }
</style>
</head>
<body>
  <main class="page">
    <header class="header">
      <div class="brand">PIVOT EDU</div>
      <div class="quote">
        <div class="quote-big">FİYAT TEKLİFİ</div>
        <div class="quote-date">Teklif Tarihi: @Date(Model.CreatedAt)</div>
      </div>
    </header>

    <section class="content">
      <div class="party mb-3">
        <h4>Müşteri</h4>
        <div class="nm">@Model.CustomerFullName</div>
        <div class="row"><strong>Telefon:</strong> @(Model.CustomerPhone ?? "—")</div>
        <div class="row"><strong>Uyruk:</strong> @(Model.CustomerNationality ?? "—")</div>
        <div class="row"><strong>Teklif #:</strong> @Model.CartGuid.ToString().Substring(0, 8).ToUpper()</div>
      </div>

      <div class="info-card">
        <div class="school">@Model.SchoolName</div>
        <div class="info-grid">
          <div class="info-item">
            <div class="ico">⌖</div>
            <div>
              <div class="label">Şehir / Ülke</div>
              <div class="value">@(string.IsNullOrEmpty(Model.CityName) ? "—" : Model.CityName)@(string.IsNullOrEmpty(Model.CountryName) ? "" : ", " + Model.CountryName)</div>
            </div>
          </div>
          <div class="info-item">
            <div class="ico">☑</div>
            <div>
              <div class="label">Program</div>
              <div class="value">@(string.IsNullOrEmpty(Model.ProgramName) ? "—" : Model.ProgramName)</div>
            </div>
          </div>
          <div class="info-item">
            <div class="ico">◷</div>
            <div>
              <div class="label">Süre</div>
              <div class="value">@(Model.MainWeeks > 0 ? Model.MainWeeks + " Hafta" : "—")</div>
            </div>
          </div>
          <div class="info-item">
            <div class="ico">▣</div>
            <div>
              <div class="label">Para Birimi</div>
              <div class="value">@Model.Currency</div>
            </div>
          </div>
        </div>
      </div>

      <h2 class="section-title">Eğitim Ücret Kalemleri</h2>
      <table>
        <thead><tr><th>Kalem</th><th>Tutar (@Model.Currency)</th></tr></thead>
        <tbody>
          @foreach (var l in Model.CourseLines)
          {
            <tr>
              <td>
                @l.Label
                @if (!string.IsNullOrEmpty(l.Detail))
                {
                    <div class="detail">@l.Detail</div>
                }
              </td>
              <td>@Money(l.Amount)</td>
            </tr>
          }
          <tr class="total-row">
            <td>Eğitim Toplamı</td>
            <td>@Money(Model.CourseTotal)</td>
          </tr>
        </tbody>
      </table>

      @if (Model.HasAccommodation)
      {
        <h2 class="section-title">Konaklama</h2>
        <table>
          <thead><tr><th>Kalem</th><th>Tutar (@Model.Currency)</th></tr></thead>
          <tbody>
            @foreach (var l in Model.AccommodationLines)
            {
              <tr>
                <td>
                  @l.Label
                  @if (!string.IsNullOrEmpty(l.Detail))
                  {
                      <div class="detail">@l.Detail</div>
                  }
                </td>
                <td>@Money(l.Amount)</td>
              </tr>
            }
            <tr class="total-row">
              <td>Konaklama Toplamı</td>
              <td>@Money(Model.AccommodationTotal)</td>
            </tr>
          </tbody>
        </table>
      }

      @if (Model.HasExtras)
      {
        <h2 class="section-title">Ekstra Masraflar</h2>
        <table>
          <thead><tr><th>Kalem</th><th>Tutar</th></tr></thead>
          <tbody>
            @foreach (var l in Model.ExtraLines)
            {
              <tr>
                <td>
                  @l.Label
                  @if (!string.IsNullOrEmpty(l.Detail))
                  {
                      <div class="detail">@l.Detail</div>
                  }
                </td>
                <td>@Money(l.Amount) @l.Currency</td>
              </tr>
            }
          </tbody>
        </table>
      }

      <div class="summary">
        <div>
          <div class="sum-sub">Tahmini Genel Toplam</div>
          <div class="sum-title">TOPLAM MALİYET</div>
          <div class="sum-note">Eğitim + konaklama + ek hizmet kalemleri toplamı.</div>
        </div>
        <div class="sum-amount"><span>@Model.Currency</span>@Money(Model.GrandTotal)</div>
      </div>

      <div class="note">
        <b>Not:</b> Fiyatlar okul, dönem, kampanya ve kur değişikliklerine göre güncellenebilir.
        Vize ücreti, uçak bileti, cep harçlığı ve kişisel giderler bilgi amaçlıdır;
        tutarlar gerçek satın alım anında değişebilir.
      </div>
    </section>

    <footer class="footer">
      Bu fiyat teklifi <b>PIVOT EDU</b> tarafından hazırlanmıştır. Detaylı bilgi için danışmanınızla iletişime geçiniz.
    </footer>
  </main>

  @if (Model.AutoPrint)
  {
    <script>window.addEventListener('load', () => setTimeout(() => window.print(), 250));</script>
  }
</body>
</html>
